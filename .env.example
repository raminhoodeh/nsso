# nsso environment variables
# Copy this file to .env.local and fill in the values needed for your workflow.

# TMDB (The Movie Database) API
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Google APIs
GOOGLE_GENERATIVE_AI_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Google Maps browser key (restrict to the site domains and to Maps JavaScript
# API + Places API (New)). A production Map ID is optional; the explorer uses
# Google's demo map ID when this is blank.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Supabase
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Creator payments
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Future wallet integration (not required for current account flows)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional local-only chatbot context source directory.
# This directory is intentionally gitignored because it can contain private CSVs.
NSSO_CONTEXT_DIR=./nsso agent context database
