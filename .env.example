# nsso environment variables
# Copy this file to .env.local and fill in the values needed for your workflow.

# TMDB (The Movie Database) API
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Google APIs
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Google Maps browser key (restrict to the site domains and to Maps JavaScript
# API + Places API (New)). A production Map ID is optional; the explorer uses
# Google's demo map ID when this is blank.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Supabase
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tahoe V4 rollout. Keep unset/off in production until the exact Preview
# artifact has passed desktop and physical-device visual approval. Use
# `material-only` as the emergency no-refraction kill switch.
NEXT_PUBLIC_TAHOE_GLASS_V4=off
# Comma-separated exact routes or `/prefix/*`. `*` is for the isolated Preview;
# production should begin with `/` and expand only after per-route approval.
NEXT_PUBLIC_TAHOE_GLASS_V4_ROUTES=/
# Leave false in production. Preview/dev may use `?tahoeV4=on|material|off`.
NEXT_PUBLIC_TAHOE_GLASS_V4_ALLOW_OVERRIDE=false
# The deterministic lab is never indexed and is hidden on production unless
# this server-side flag is explicitly enabled.
ENABLE_GLASS_LAB_V4=false

# Payments
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
POLAR_ACCESS_TOKEN=
POLAR_API_URL=https://sandbox-api.polar.sh/v1
POLAR_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=

# Wallets
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional local-only chatbot context source directory.
# This directory is intentionally gitignored because it can contain private CSVs.
NSSO_CONTEXT_DIR=./nsso agent context database
